<section
  class="brand-claims color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="brand-claims__wrapper">
    {% for block in section.blocks %}
      <div class="brand-claims__item" {{ block.shopify_attributes }}>
        <div class="brand-claims__icon">
          {% if block.settings.icon != blank %}
            {{
              block.settings.icon
              | image_url: width: 80
              | image_tag:
                width: 40,
                height: 40,
                loading: 'lazy',
                alt: block.settings.label,
                class: 'brand-claims__icon-img'
            }}
          {% elsif block.settings.icon_file != blank %}
            <img
              src="{{ block.settings.icon_file | asset_url }}"
              alt="{{ block.settings.label | escape }}"
              width="40"
              height="40"
              loading="lazy"
              class="brand-claims__icon-img"
            >
          {% endif %}
        </div>
        <span class="brand-claims__label">{{ block.settings.label | escape }}</span>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .brand-claims {
    background-color: var(--color-background);
    padding-block-start: var(--padding-block-start, 20px);
    padding-block-end: var(--padding-block-end, 20px);
    padding-inline: var(--page-margin, 16px);
  }

  .brand-claims__wrapper {
    display: flex;
    flex-direction: row;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
  }

  .brand-claims__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .brand-claims__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }

  .brand-claims__icon-img {
    display: block;
    width: 40px;
    height: 40px;
  }

  .brand-claims__label {
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: 12px;
    line-height: 18px;
    text-align: center;
    color: var(--color-primary);
  }

  @media screen and (min-width: 750px) {
    .brand-claims {
      padding-inline: 64px;
    }

    .brand-claims__wrapper {
      gap: 80px;
      justify-content: center;
    }

    .brand-claims__item {
      flex-direction: row;
      gap: 12px;
    }

    .brand-claims__label {
      font-size: 16px;
      line-height: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand claims",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "claim",
      "name": "Claim",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_file",
          "label": "Icon filename",
          "info": "SVG filename from assets/ as fallback (e.g. icon.svg)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Claim"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand claims",
      "blocks": [
        {
          "type": "claim",
          "settings": {
            "label": "Parent Owned",
            "icon_file": "third-party-tested.svg"
          }
        },
        {
          "type": "claim",
          "settings": {
            "label": "3rd Party Tested",
            "icon_file": "third-party-tested-2.svg"
          }
        },
        {
          "type": "claim",
          "settings": {
            "label": "Allergen Free",
            "icon_file": "no-allergen.svg"
          }
        },
        {
          "type": "claim",
          "settings": {
            "label": "USDA Organic",
            "icon_file": "third-party-tested-3.svg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
