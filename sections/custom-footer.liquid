{% liquid
  assign color_scheme = section.settings.color_scheme
  assign menu_1 = section.settings.menu_1
  assign menu_2 = section.settings.menu_2
  assign menu_3 = section.settings.menu_3
  assign policy_menu = section.settings.policy_menu
  assign show_badges = section.settings.show_badges
  assign show_country_selector = section.settings.show_country_selector
%}

<div class="section-background color-{{ color_scheme }}"></div>
<div class="section section--page-width color-{{ color_scheme }}">
  <div
    class="custom-footer spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- comment -%} ===== SUBSCRIBE SECTION ===== {%- endcomment -%}
    <div class="custom-footer__subscribe">
      <div class="custom-footer__subscribe-copy">
        {% if section.settings.subscribe_heading != blank %}
          <h3 class="custom-footer__heading">{{ section.settings.subscribe_heading }}</h3>
        {% endif %}
        {% if section.settings.subscribe_description != blank %}
          <p class="custom-footer__description">{{ section.settings.subscribe_description }}</p>
        {% endif %}
      </div>
      {% form 'customer', class: 'custom-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="custom-footer__form-row">
          <input
            type="email"
            name="contact[email]"
            class="custom-footer__email-input"
            placeholder="{{ section.settings.email_placeholder }}"
            autocomplete="email"
            required
            aria-label="{{ section.settings.email_placeholder }}"
          >
          <button type="submit" class="custom-footer__email-button">
            {{ section.settings.email_button_label }}
          </button>
        </div>
      {% endform %}
    </div>

    {%- comment -%} ===== SOCIAL ICONS ===== {%- endcomment -%}
    <div class="custom-footer__social">
      {% if section.settings.social_instagram_url != blank %}
        <a href="{{ section.settings.social_instagram_url }}" class="custom-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'instagram-icon.svg' | asset_url }}" alt="Instagram" width="24" height="24" loading="lazy">
        </a>
      {% endif %}
      {% if section.settings.social_tiktok_url != blank %}
        <a href="{{ section.settings.social_tiktok_url }}" class="custom-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'tiktok-icon.svg' | asset_url }}" alt="TikTok" width="24" height="24" loading="lazy">
        </a>
      {% endif %}
      {% if section.settings.social_facebook_url != blank %}
        <a href="{{ section.settings.social_facebook_url }}" class="custom-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'facebook-icon.svg' | asset_url }}" alt="Facebook" width="24" height="24" loading="lazy">
        </a>
      {% endif %}
      {% if section.settings.social_linkedin_url != blank %}
        <a href="{{ section.settings.social_linkedin_url }}" class="custom-footer__social-link" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'linkedin-icon.svg' | asset_url }}" alt="LinkedIn" width="24" height="24" loading="lazy">
        </a>
      {% endif %}
      {% if section.settings.social_amazon_url != blank %}
        <a href="{{ section.settings.social_amazon_url }}" class="custom-footer__social-link" aria-label="Amazon" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'amazon-icon.svg' | asset_url }}" alt="Amazon" width="24" height="24" loading="lazy">
        </a>
      {% endif %}
    </div>

    {%- comment -%} ===== MENU COLUMNS / ACCORDIONS ===== {%- endcomment -%}
    <div class="custom-footer__menus">
      {% if menu_1 != blank %}
        <div class="custom-footer__menu-col">
          {% capture menu_1_children %}
            <details class="custom-footer__menu-details" open>
              <summary class="custom-footer__menu-summary">
                <span class="custom-footer__menu-title">{{ menu_1.title }}</span>
                <span class="custom-footer__menu-caret">
                  <img src="{{ 'caretdown.svg' | asset_url }}" alt="" width="20" height="20">
                </span>
              </summary>
              <nav class="details-content" aria-label="{{ menu_1.title | escape }}">
                <ul class="list-unstyled custom-footer__menu-list">
                  {% for link in menu_1.links %}
                    <li class="custom-footer__menu-item">
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </nav>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: menu_1_children,
            class: 'custom-footer__accordion',
            disable_on_desktop: true,
            open_by_default_on_desktop: true
          %}
        </div>
      {% endif %}

      {% if menu_2 != blank %}
        <div class="custom-footer__menu-col">
          {% capture menu_2_children %}
            <details class="custom-footer__menu-details" open>
              <summary class="custom-footer__menu-summary">
                <span class="custom-footer__menu-title">{{ menu_2.title }}</span>
                <span class="custom-footer__menu-caret">
                  <img src="{{ 'caretdown.svg' | asset_url }}" alt="" width="20" height="20">
                </span>
              </summary>
              <nav class="details-content" aria-label="{{ menu_2.title | escape }}">
                <ul class="list-unstyled custom-footer__menu-list">
                  {% for link in menu_2.links %}
                    <li class="custom-footer__menu-item">
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </nav>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: menu_2_children,
            class: 'custom-footer__accordion',
            disable_on_desktop: true,
            open_by_default_on_desktop: true
          %}
        </div>
      {% endif %}

      {% if menu_3 != blank %}
        <div class="custom-footer__menu-col">
          {% capture menu_3_children %}
            <details class="custom-footer__menu-details" open>
              <summary class="custom-footer__menu-summary">
                <span class="custom-footer__menu-title">{{ menu_3.title }}</span>
                <span class="custom-footer__menu-caret">
                  <img src="{{ 'caretdown.svg' | asset_url }}" alt="" width="20" height="20">
                </span>
              </summary>
              <nav class="details-content" aria-label="{{ menu_3.title | escape }}">
                <ul class="list-unstyled custom-footer__menu-list">
                  {% for link in menu_3.links %}
                    <li class="custom-footer__menu-item">
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </nav>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: menu_3_children,
            class: 'custom-footer__accordion',
            disable_on_desktop: true,
            open_by_default_on_desktop: true
          %}
        </div>
      {% endif %}
    </div>

    {%- comment -%} ===== CERTIFICATION BADGES ===== {%- endcomment -%}
    {% if show_badges %}
      <div class="custom-footer__badges">
        <img src="{{ 'third-party-tested.svg' | asset_url }}" alt="Third party tested" width="40" height="40" loading="lazy">
        <img src="{{ 'no-allergen-2.svg' | asset_url }}" alt="No allergens" width="40" height="40" loading="lazy">
        <img src="{{ 'container.svg' | asset_url }}" alt="Certified" width="40" height="40" loading="lazy">
        <img src="{{ 'no-allergen.svg' | asset_url }}" alt="Allergen free" width="40" height="40" loading="lazy">
        <img src="{{ 'plasticnegative-product-black-v-1.svg' | asset_url }}" alt="Plastic negative" width="40" height="40" loading="lazy">
      </div>
    {% endif %}

    {%- comment -%} ===== FOOTER BOTTOM: Policies + Country ===== {%- endcomment -%}
    <div class="custom-footer__footer-bottom">
      {%- comment -%} Policies + Copyright {%- endcomment -%}
      <div class="custom-footer__policies-section">
        <div class="custom-footer__divider"></div>
        <div class="custom-footer__policies-wrap">
          {% if policy_menu != blank %}
            {% for link in policy_menu.links %}
              <a href="{{ link.url }}" class="custom-footer__policy-link">{{ link.title }}</a>
            {% endfor %}
          {% endif %}
          {% if section.settings.copyright_text != blank %}
            <span class="custom-footer__copyright custom-footer__copyright--desktop">{{ section.settings.copyright_text }}</span>
          {% endif %}
        </div>
        <div class="custom-footer__divider"></div>
        {% if section.settings.copyright_text != blank %}
          <p class="custom-footer__copyright custom-footer__copyright--mobile">{{ section.settings.copyright_text }}</p>
        {% endif %}
      </div>

      {%- comment -%} Country Selector {%- endcomment -%}
      {% if show_country_selector %}
        <div class="custom-footer__country">
          <details class="custom-footer__country-disclosure">
            <summary class="custom-footer__country-pill">
              <div class="custom-footer__country-pill-inner">
                <span class="custom-footer__country-flag">
                  {{ localization.country | image_url: width: 64 | image_tag: width: 32, height: 32, class: 'custom-footer__flag-img', loading: 'lazy' }}
                </span>
                <span class="custom-footer__country-text">{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span>
              </div>
              <img src="{{ 'caretdown.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            </summary>
            <div class="custom-footer__country-dropdown">
              {% render 'localization-form', show_country: true, show_language: false, form_id: section.id, localization_style: 'dropdown' %}
            </div>
          </details>
        </div>
      {% endif %}
    </div>

    {%- comment -%} ===== DISCLAIMER ===== {%- endcomment -%}
    {% if section.settings.disclaimer_text != blank %}
      <div class="custom-footer__disclaimer">
        <p class="custom-footer__disclaimer-text">{{ section.settings.disclaimer_text }}</p>
      </div>
    {% endif %}

    {%- comment -%} ===== ILLUSTRATION ===== {%- endcomment -%}
    {% if section.settings.illustration_image != blank %}
      <div class="custom-footer__illustration">
        {%- liquid
          assign ill_alt = section.settings.illustration_image.alt | default: ''
        -%}
        {{ section.settings.illustration_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'custom-footer__illustration-img', alt: ill_alt }}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* ==========================================================================
     CUSTOM FOOTER — Mobile-first layout
     ========================================================================== */

  .custom-footer {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow: hidden;
  }

  /* Mobile ordering */
  .custom-footer__subscribe { order: 1; }
  .custom-footer__social { order: 2; }
  .custom-footer__menus { order: 3; }
  .custom-footer__badges { order: 4; }

  /* On mobile, footer-bottom uses display:contents so its children become
     direct flex items and can be reordered independently */
  .custom-footer__footer-bottom {
    display: contents;
  }

  .custom-footer__country { order: 5; margin-block-start: 8px; }
  .custom-footer__disclaimer { order: 6; margin-block-start: 8px; }
  .custom-footer__policies-section { order: 7; margin-block-start: 8px; }
  .custom-footer__illustration { order: 8; margin-block-start: 8px; }

  /* ==========================================================================
     SUBSCRIBE SECTION
     ========================================================================== */

  .custom-footer__subscribe {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .custom-footer__subscribe-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .custom-footer__heading {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .custom-footer__description {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 18px;
    color: var(--color-foreground);
    margin: 0;
  }

  .custom-footer__form {
    margin: 0;
  }

  .custom-footer__form-row {
    display: flex;
    gap: 8px;
  }

  .custom-footer__email-input {
    flex: 1;
    min-width: 0;
    height: 48px;
    border-radius: 24px;
    border: 1px solid var(--color-border);
    background-color: var(--color-input-background);
    padding-inline: 16px;
    font-family: var(--font-accent--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    color: var(--color-input-text);
    outline: none;
  }

  .custom-footer__email-input::placeholder {
    color: var(--color-input-text);
  }

  .custom-footer__email-input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .custom-footer__email-button {
    flex-shrink: 0;
    height: 48px;
    padding-inline: 20px;
    border-radius: 24px;
    border: none;
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 14px;
    line-height: 14px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--animation-speed, 0.2s) var(--animation-easing, ease);
    white-space: nowrap;
  }

  .custom-footer__email-button:hover {
    background-color: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
  }

  .custom-footer__email-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ==========================================================================
     SOCIAL ICONS
     ========================================================================== */

  .custom-footer__social {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 20px;
    gap: 24px;
  }

  .custom-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .custom-footer__social-link:hover {
    opacity: 0.7;
  }

  .custom-footer__social-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .custom-footer__social-link img {
    display: block;
  }

  /* ==========================================================================
     MENUS — mobile: accordion, desktop: flat columns
     ========================================================================== */

  .custom-footer__menus {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .custom-footer__menu-col {
    border-block-start: 1px solid var(--color-border);
  }

  .custom-footer__menu-col:last-child {
    border-block-end: 1px solid var(--color-border);
  }

  .custom-footer__accordion {
    display: block;
  }

  .custom-footer__menu-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    padding-block: 16px;
  }

  .custom-footer__menu-summary::-webkit-details-marker {
    display: none;
  }

  .custom-footer__menu-title {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-foreground-heading);
    text-transform: capitalize;
  }

  .custom-footer__menu-caret {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    transition: transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .custom-footer__menu-caret img {
    display: block;
  }

  .custom-footer__menu-details[open] .custom-footer__menu-caret {
    transform: rotate(180deg);
  }

  .custom-footer__menu-details .details-content {
    padding-block-end: 16px;
  }

  .custom-footer__menu-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .custom-footer__menu-item a {
    font-family: var(--font-accent--family);
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    color: var(--color-foreground-heading);
    text-decoration: none;
    transition: opacity var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .custom-footer__menu-item a:hover {
    opacity: 0.7;
  }

  .custom-footer__menu-item a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* ==========================================================================
     CERTIFICATION BADGES
     ========================================================================== */

  .custom-footer__badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 20px;
    gap: 16px;
  }

  .custom-footer__badges img {
    display: block;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  /* ==========================================================================
     POLICIES + COPYRIGHT
     ========================================================================== */

  .custom-footer__policies-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .custom-footer__divider {
    width: 100%;
    height: 1px;
    background-color: var(--color-foreground-heading);
    opacity: 0.3;
  }

  .custom-footer__policies-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  .custom-footer__policy-link {
    font-family: var(--font-accent--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-foreground-heading);
    text-decoration: underline;
    transition: opacity var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .custom-footer__policy-link:hover {
    opacity: 0.7;
  }

  .custom-footer__policy-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .custom-footer__copyright {
    font-family: var(--font-accent--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  /* Mobile: show mobile copyright (centered), hide desktop copyright (inline) */
  .custom-footer__copyright--desktop {
    display: none;
  }

  .custom-footer__copyright--mobile {
    text-align: center;
  }

  /* ==========================================================================
     COUNTRY SELECTOR
     ========================================================================== */

  .custom-footer__country-disclosure {
    position: relative;
  }

  .custom-footer__country-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 16px 8px 8px;
    border-radius: 28px;
    background-color: #ffffff;
    border: 1px solid #ffffff;
    cursor: pointer;
    list-style: none;
    width: 100%;
  }

  .custom-footer__country-pill::-webkit-details-marker {
    display: none;
  }

  .custom-footer__country-pill-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .custom-footer__flag-img {
    width: 32px;
    height: 32px;
    border-radius: 20px;
    object-fit: cover;
    display: block;
  }

  .custom-footer__country-text {
    font-family: var(--font-accent--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    color: var(--color-foreground-heading);
    white-space: nowrap;
  }

  .custom-footer__country-pill > img {
    display: block;
    flex-shrink: 0;
  }

  .custom-footer__country-dropdown {
    position: absolute;
    bottom: calc(100% + 8px);
    inset-inline: 0;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    max-height: 300px;
    overflow-y: auto;
    z-index: 10;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
  }

  .custom-footer__country-disclosure:not([open]) .custom-footer__country-dropdown {
    display: none;
  }

  /* ==========================================================================
     DISCLAIMER
     ========================================================================== */

  .custom-footer__disclaimer {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 12px;
  }

  .custom-footer__disclaimer-text {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 10px;
    line-height: 14px;
    color: var(--color-foreground);
    margin: 0;
  }

  /* ==========================================================================
     ILLUSTRATION
     ========================================================================== */

  .custom-footer__illustration {
    display: flex;
    justify-content: center;
  }

  .custom-footer__illustration-img {
    display: block;
    max-width: 280px;
    height: auto;
  }

  /* ==========================================================================
     DESKTOP LAYOUT (min-width: 750px)
     ========================================================================== */

  @media screen and (min-width: 750px) {
    .custom-footer {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto auto auto;
      column-gap: 32px;
      row-gap: 0;
    }

    /* Reset mobile ordering and margins */
    .custom-footer__subscribe,
    .custom-footer__social,
    .custom-footer__menus,
    .custom-footer__badges,
    .custom-footer__country,
    .custom-footer__disclaimer,
    .custom-footer__policies-section,
    .custom-footer__illustration {
      order: unset;
      margin-block-start: 0;
    }

    /* Grid placement */
    .custom-footer__menus {
      grid-column: 1;
      grid-row: 1;
    }

    .custom-footer__subscribe {
      grid-column: 2;
      grid-row: 1;
    }

    .custom-footer__social {
      grid-column: 2;
      grid-row: 2;
      margin-block-start: 24px;
      justify-content: flex-start;
      padding-inline: 0;
      gap: 64px;
    }

    .custom-footer__badges {
      grid-column: 1;
      grid-row: 2;
      margin-block-start: 40px;
      align-self: start;
      justify-content: flex-start;
      padding-inline: 0;
    }

    .custom-footer__footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 40px;
      grid-column: 1;
      grid-row: 3;
      margin-block-start: 40px;
    }

    .custom-footer__disclaimer {
      grid-column: 1;
      grid-row: 4;
      margin-block-start: 40px;
      border-radius: 8px 8px 0 0;
    }

    .custom-footer__illustration {
      grid-column: 2;
      grid-row: 3 / 6;
      align-self: end;
      justify-self: end;
    }

    .custom-footer__illustration-img {
      max-width: 420px;
    }

    /* Desktop form gap */
    .custom-footer__form-row {
      gap: 16px;
    }

    /* Desktop menus: 3-column flat layout */
    .custom-footer__menus {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }

    .custom-footer__menu-col {
      border: none;
    }

    .custom-footer__menu-col:last-child {
      border: none;
    }

    /* Desktop summary styling */
    .custom-footer__menu-summary {
      cursor: default;
      padding-block: 0;
      margin-block-end: 12px;
    }

    .custom-footer__menu-title {
      font-size: 16px;
      line-height: 24px;
    }

    .custom-footer__menu-caret {
      display: none;
    }

    /* Desktop policies: horizontal flow */
    .custom-footer__policies-section {
      flex: 1;
    }

    .custom-footer__divider {
      display: none;
    }

    .custom-footer__policies-wrap {
      justify-content: flex-start;
      gap: 12px 24px;
    }

    /* Desktop: show inline copyright, hide mobile copyright */
    .custom-footer__copyright--desktop {
      display: inline;
    }

    .custom-footer__copyright--mobile {
      display: none;
    }

    /* Desktop country selector styling */
    .custom-footer__country {
      flex-shrink: 0;
      align-self: center;
    }
  }

  /* ==========================================================================
     REDUCED MOTION
     ========================================================================== */

  @media (prefers-reduced-motion: reduce) {
    .custom-footer__email-button,
    .custom-footer__social-link,
    .custom-footer__menu-item a,
    .custom-footer__menu-caret,
    .custom-footer__policy-link {
      transition: none;
    }
  }
{% endstylesheet %}

